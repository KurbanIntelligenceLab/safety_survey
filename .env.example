# Copy to .env and fill in; load with:  set -a; . ./.env; set +a
S2_API_KEY=            # Semantic Scholar API key (abstract enrichment, snowball, full-text index)
ANTHROPIC_API_KEY=     # only for the external-API route of pipeline/03_classify/classify_llm.py
OPENAI_API_KEY=        # only for pipeline/04_validate/openai_crossfamily_validate.py
CONTACT_EMAIL=         # sent in the User-Agent / mailto of polite-pool requests (DBLP, Crossref, OpenAlex, publishers)
